--- /dev/null
+++ b/packages/core/tests/spawn-batch.test.ts
@@ -0,0 +1,213 @@
+import { describe, expect, it } from 'vitest';
+import {
+    createWorld,
+    trait,
+    spawnBatch,
+    Not,
+    relation,
+    createAdded,
+    writeLog,
+    unpackEntity,
+    IncludeDisabled,
+    getStore,
+    type ConfigurableTrait,
+    type Entity,
+    type World,
+} from '../src';
+
+type Spawn = (world: World, count: number, ...traits: ConfigurableTrait[]) => Entity[];
+const repeated: Spawn = (world, count, ...traits) =>
+    Array.from({ length: count }, () => world.spawn(...traits));
+
+function trace(spawn: Spawn, action: string) {
+    const world = createWorld();
+    const Position = trait({ x: 3 });
+    const Velocity = trait({ x: 5 });
+    const Excluded = trait();
+    const Added = createAdded();
+    const events: unknown[] = [];
+    const snapshot = (entity: Entity) => [
+        entity.get(Position),
+        entity.get(Velocity),
+        entity.has(Excluded),
+    ];
+    world.onQueryAdd([Not(Excluded)], (entity) => events.push(['empty', snapshot(entity)]));
+    world.onQueryAdd([Position], (entity) => events.push(['query', snapshot(entity)]));
+    world.onQueryAdd([Position, Velocity], (entity) => events.push(['both', snapshot(entity)]));
+    let calls = 0;
+    world.onAdd(Position, (entity) => {
+        events.push(['trait', snapshot(entity)]);
+        calls++;
+        if (action === 'reenter' && calls === 1) spawn(world, 1, Velocity);
+        if (action === 'destroy' && calls === 2) entity.destroy();
+        if (action === 'throw' && calls === 3) throw new Error('stop');
+        if (action === 'schema' && calls === 1) Position.schema.x = 8;
+        if (action === 'query' && calls === 1) world.query(Velocity);
+    });
+    world.query(Added(Position));
+    let error: string | undefined;
+    try {
+        spawn(world, 4, Position, Velocity);
+    } catch (caught) {
+        error = (caught as Error).message;
+    }
+    const values = world.query(Position, IncludeDisabled()).map(snapshot);
+    const added = world.query(Added(Position)).length;
+    world.destroy();
+    return { events, values, added, error };
+}
+
+describe('Entityの一括生成', () => {
+    it.each(['plain', 'reenter', 'destroy', 'throw', 'schema', 'query'])(
+        '通知と途中の状態が反復生成と一致する: %s',
+        (action) => {
+            expect(trace(spawnBatch, action)).toEqual(trace(repeated, action));
+        }
+    );
+    it.each(['reset', 'destroy'] as const)(
+        '通知からWorldを%sしても反復生成と一致する',
+        (operation) => {
+            const run = (spawn: Spawn) => {
+                const world = createWorld();
+                const Value = trait({ x: 4 });
+                const events: number[] = [];
+                world.onAdd(Value, (entity) => {
+                    events.push(entity.get(Value)!.x);
+                    if (events.length === 2) world[operation]();
+                });
+                let error: string | undefined;
+                try {
+                    spawn(world, 4, Value);
+                } catch (caught) {
+                    error = (caught as Error).message;
+                }
+                const initialized = world.isInitialized;
+                const values = initialized
+                    ? world.query(Value).map((entity) => entity.get(Value)!.x)
+                    : [];
+                if (initialized) world.destroy();
+                return { events, initialized, values: [...values], error };
+            };
+            expect(run(spawnBatch)).toEqual(run(repeated));
+        }
+    );
+
+    it('初期値、重複Trait、Query、再利用したIDの世代を保つ', () => {
+        const world = createWorld();
+        const Position = trait({ x: 3, y: 4 });
+        const Velocity = trait({ x: 7 });
+        const Added = createAdded();
+        world.query(Position, Velocity);
+        world.query(Added(Position));
+        const rows = spawnBatch(world, 8, Position, Velocity, Position);
+        expect([...world.query(Position, Velocity)]).toEqual(rows);
+        expect([...world.query(Added(Position))]).toEqual(rows);
+        for (const entity of rows) expect(entity.get(Position)).toEqual({ x: 3, y: 4 });
+        const old = rows[0];
+        old.destroy();
+        const next = spawnBatch(world, 1, Position)[0];
+        expect(next).not.toBe(old);
+        expect(world.has(old)).toBe(false);
+        expect(unpackEntity(next).entityId).toBe(unpackEntity(old).entityId);
+        next.setEnabled(false);
+        expect(world.query(Position)).not.toContain(next);
+        expect(world.query(Position, IncludeDisabled())).toContain(next);
+        world.destroy();
+    });
+    it('Queryを後から作る場合も複数世代のmaskと独立した所属を保つ', () => {
+        const run = (spawn: Spawn) => {
+            const world = createWorld();
+            const Added = createAdded();
+            const values = Array.from({ length: 64 }, (_, x) => trait({ x }));
+            const rows = spawn(world, 16, ...values);
+            const initialized = rows.map((entity) => values.map((value) => entity.get(value)!.x));
+            rows[0].remove(values[0]);
+            const included = world.query(values[0], values[63]).map((entity) => rows.indexOf(entity));
+            const absent = world
+                .query(Not(values[0]), values[63])
+                .map((entity) => rows.indexOf(entity));
+            const added = world.query(Added(values[63])).map((entity) => rows.indexOf(entity));
+            world.destroy();
+            return { initialized, included: [...included], absent: [...absent], added: [...added] };
+        };
+        expect(run(spawnBatch)).toEqual(run(repeated));
+    });
+
+    it('factoryの呼出し回数と独立値を保つ', () => {
+        const world = createWorld();
+        let calls = 0;
+        const SoA = trait({ value: () => ({ count: ++calls }) });
+        const AoS = trait(() => ({ values: [++calls] }));
+        const rows = spawnBatch(world, 3, SoA, AoS);
+        expect(calls).toBe(6);
+        expect(rows.map((entity) => entity.get(SoA)!.value.count)).toEqual([1, 3, 5]);
+        const first = rows[0].get(SoA)!.value;
+        first.count = 99;
+        expect(rows[1].get(SoA)!.value.count).toBe(3);
+        expect(rows[0].get(AoS)).not.toBe(rows[1].get(AoS));
+        world.destroy();
+    });
+    it('設定値のgetterと通知による値の変更を生成順に読む', () => {
+        const world = createWorld();
+        const Value = trait({ x: 0 });
+        let value = 1;
+        const params = {
+            get x() {
+                return value++;
+            },
+        };
+        const rows = spawnBatch(world, 3, Value(params));
+        expect(rows.map((entity) => entity.get(Value)!.x)).toEqual([1, 2, 3]);
+        world.destroy();
+    });
+    it('Relation対象の寿命と削除通知を保つ', () => {
+        const world = createWorld();
+        const target = world.spawn();
+        const Parent = relation({ exclusive: true, autoDestroy: 'source' });
+        const rows = spawnBatch(world, 3, Parent(target));
+        expect([...world.query(Parent(target))]).toEqual(rows);
+        target.destroy();
+        for (const entity of rows) expect(world.has(entity)).toBe(false);
+        world.destroy();
+    });
+    it('初期化の保存履歴を各Entityについて記録する', () => {
+        const world = createWorld();
+        const Value = trait({ x: 1 });
+        const first = world.spawn(Value);
+        const log = writeLog(world, Value);
+        const since = log.revision!;
+        const rows = spawnBatch(world, 3, Value);
+        const changed: Entity[] = [];
+        expect(log.forEachChanged(since, (entity) => changed.push(entity))).toBe(true);
+        expect(changed).toEqual(rows);
+        expect(changed).not.toContain(first);
+        world.destroy();
+    });
+    it('公開済みstoreのsetterを既存の生成と同じ回数で呼ぶ', () => {
+        const world = createWorld();
+        const Value = trait({ x: 1 });
+        world.spawn(Value).destroy();
+        const store = getStore(world, Value);
+        let calls = 0;
+        const column = store.x;
+        store.x = new Proxy(column, {
+            set(target, key, value) {
+                calls++;
+                return Reflect.set(target, key, value);
+            },
+        });
+        spawnBatch(world, 3, Value);
+        expect(calls).toBe(3);
+        world.destroy();
+    });
+    it('0件はTraitを登録せず、不正な件数は生成前に拒否する', () => {
+        const world = createWorld();
+        const Value = trait({ x: 1 });
+        expect(spawnBatch(world, 0, Value)).toEqual([]);
+        expect(world.traits.has(Value)).toBe(false);
+        for (const count of [-1, 0.1, NaN, Infinity, 2 ** 32])
+            expect(() => spawnBatch(world, count, Value)).toThrow(RangeError);
+        expect(world.query(Value)).toHaveLength(0);
+        world.destroy();
+    });
+});
