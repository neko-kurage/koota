+// FORK(Entity/batch-spawn): 利用者の処理を呼ばない初期化だけを、一括呼出しの間で共有する。
+export function prepareBatchTraits(
+    world: World,
+    traits: ConfigurableTrait[]
+): ((entity: Entity) => void) | undefined {
+    const ctx = world[$internal];
+    for (const query of ctx.queriesHashMap.values()) {
+        if (query.addSubscriptions.size || query.removeSubscriptions.size) return;
+    }
+
+    const prepared: { trait: Trait; value: Record<string, any> }[] = [];
+    for (const config of traits) {
+        if (Array.isArray(config) || isRelationPair(config)) return;
+        const trait = config as Trait;
+        if (isOrderedTrait(trait) || trait[$internal].type === 'aos') return;
+        const instance = getTraitInstance(ctx.traitInstances, trait);
+        if (instance?.addSubscriptions.size || instance?.storeExposed) return;
+        const schema = trait.schema as Record<string, unknown>;
+        if (Object.getPrototypeOf(schema) !== Object.prototype) return;
+        const value: Record<string, any> = {};
+        for (const key of Object.keys(schema)) {
+            const descriptor = Object.getOwnPropertyDescriptor(schema, key)!;
+            if (!('value' in descriptor) || typeof descriptor.value === 'function') return;
+            value[key] = descriptor.value;
+        }
+        prepared.push({ trait, value });
+    }
+
+    return (entity) => {
+        for (let index = 0; index < prepared.length; index++) {
+            const { trait, value } = prepared[index];
+            const instance = addTraitToEntity(world, entity, trait);
+            if (instance) trait[$internal].set(getEntityId(entity), instance.store, value);
+        }
+    };
+}
